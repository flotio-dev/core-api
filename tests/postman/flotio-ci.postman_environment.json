{
  "id": "flotio-ci-env",
  "name": "Flotio - CI",
  "values": [
    { "key": "baseUrl",     "value": "http://localhost:8080", "enabled": true },
    { "key": "skipGitHub",  "value": "true",                  "enabled": true, "description": "GitHub App non disponible en CI" },
    { "key": "skipBuilds",  "value": "true",                  "enabled": true, "description": "Kubernetes non disponible en CI" }
  ],
  "_postman_variable_scope": "environment"
}
