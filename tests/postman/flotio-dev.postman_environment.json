{
  "id": "flotio-dev-env",
  "name": "Flotio - Dev local",
  "values": [
    { "key": "baseUrl",     "value": "http://localhost:8080", "enabled": true },
    { "key": "skipGitHub",  "value": "false",                 "enabled": true, "description": "Passer à 'true' pour skipper les tests GitHub App" },
    { "key": "skipBuilds",  "value": "true",                  "enabled": true, "description": "Passer à 'false' si Kubernetes est disponible localement" }
  ],
  "_postman_variable_scope": "environment"
}
