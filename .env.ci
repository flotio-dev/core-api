# =============================================================================
# core-api - CI
# Secrets sensibles injectés via GitHub Actions secrets (voir workflow)
# =============================================================================

API_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgres://flotio:flotio@postgres:5432/flotio?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Remplacé par les secrets GitHub Actions
ACCESS_TOKEN_SECRET=ci-access-secret-32chars-minimum!
REFRESH_TOKEN_SECRET=ci-refresh-secret-32chars-minimum!

# GitHub App — non utilisé en CI (tests skippés)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Kubernetes — non utilisé en CI (tests skippés)
KUBECTL_API=
KUBECTL_TOKEN=
K8S_NAMESPACE=default
FLUTTER_BUILD_IMAGE=
FLUTTER_BUILD_IMAGE_PULL_POLICY=Always

# S3 — non utilisé en CI
AWS_S3_BUCKET=
AWS_S3_PREFIX=
AWS_S3_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
