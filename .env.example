# API Configuration
API_PORT=8080
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database Configuration
DATABASE_URL=postgres://flotio:flotio@localhost:5432/flotio?sslmode=disable

# Github Configuration
GITHUB_WEBHOOK_SECRET=

# Secrets Encryption Key (Required: base64-encoded 32 bytes for AES-256-GCM)
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=Y2ktc2VjcmV0cy1lbmNyeXB0aW9uLWtleS0zMmJ5dGU=

# Kubernetes Configuration
KUBECTL_API=
KUBECTL_TOKEN=
K8S_NAMESPACE=default
FLUTTER_BUILD_IMAGE=ghcr.io/flotio-dev/flutter-build:latest
FLUTTER_BUILD_IMAGE_PULL_POLICY=Always

# Authentication Configuration
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# S3 Configuration
AWS_S3_BUCKET=
AWS_S3_PREFIX=builds
AWS_S3_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
