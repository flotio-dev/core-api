# syntax=docker/dockerfile:1
# Image de build légère pour la CI — pas d'Air, compilation directe
ARG GO_VERSION=1.25
FROM golang:${GO_VERSION}-alpine AS build

RUN apk add --no-cache git

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

RUN CGO_ENABLED=0 go build -buildvcs=false -ldflags="-w -s" -o /bin/server ./cmd/api

FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata

COPY --from=build /bin/server /bin/server

EXPOSE 8080

CMD ["/bin/server"]
